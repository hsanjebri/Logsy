{
  "name": "@logsy/core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure log-processing logic: cleaning, error location, redaction, fingerprinting, rules, comment formatting",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
