# Copy to .env and fill in. Never commit .env.
# Each app validates only the variables it uses; missing ones fail fast with a clear error.

# ─── General ────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ─── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000
# Parallel analyze-run jobs per worker process.
WORKER_CONCURRENCY=5

# ─── Infrastructure (matches deploy/docker-compose.yml defaults) ───────────
# Used by docker compose to initialise Postgres. The password only applies when
# the data volume is first created.
POSTGRES_USER=logsy
POSTGRES_PASSWORD=logsy
POSTGRES_DB=logsy
# Change if another Postgres already listens on 5432 (and update DATABASE_URL).
POSTGRES_PORT=5432
REDIS_PORT=6379
# Used by the apps. Must be postgres:// or postgresql://
DATABASE_URL=postgres://logsy:logsy@localhost:5432/logsy
# Must be redis:// or rediss://
REDIS_URL=redis://localhost:6379
# Optional. Server used by integration tests; they create and drop their own
# logsy_test_* databases on it. Defaults to the server in DATABASE_URL.
# TEST_DATABASE_URL=postgres://logsy:logsy@localhost:5432/postgres

# ─── GitHub App (see docs/github-app-setup.md) ──────────────────────────────
# Webhook secret configured on the app (min 16 chars). Used by the server.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_WEBHOOK_SECRET=
# Numeric App ID from the app's settings page. Used by the worker (Phase 2).
GITHUB_APP_ID=
# PEM private key on one line, with newlines written as \n. Used by the worker (Phase 2).
GITHUB_PRIVATE_KEY=

# ─── LLM ────────────────────────────────────────────────────────────────────
# Set to false to run on rules alone, with no LLM configured.
LLM_ENABLED=true
# anthropic | openai | ollama
LLM_PROVIDER=anthropic
# Model used for analysis. Required. Never hardcoded in code.
LLM_MODEL=claude-opus-5
# Optional cheaper model for short, simple logs.
LLM_MODEL_FAST=claude-haiku-4-5
# Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Required when LLM_PROVIDER=openai.
OPENAI_API_KEY=
# Used when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
