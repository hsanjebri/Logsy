{
  "name": "logsy",
  "private": true,
  "description": "Logsy — AI CI failure analyzer for GitHub Actions",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f deploy/docker-compose.yml up -d",
    "db:down": "docker compose -f deploy/docker-compose.yml down"
  },
  "devDependencies": {
    "@logsy/config": "workspace:*",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "turbo": "^2.10.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
